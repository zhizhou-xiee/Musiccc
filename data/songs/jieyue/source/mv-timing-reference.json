 "mv_scenes": [
  {
   "key": "acap1",
   "start": 0.0,
   "end": 13.06,
   "desc": "屋顶上一只小机在打盹，一片花瓣飘过；片名「借月」"
  },
  {
   "key": "acap2",
   "start": 13.06,
   "end": 23.3,
   "desc": "厨房里准备月饼"
  },
  {
   "key": "intro",
   "start": 23.3,
   "end": 33.78,
   "desc": "月饼特写 → 灯笼桌 → 街道，片头字幕"
  },
  {
   "key": "v1",
   "start": 33.78,
   "end": 54.47,
   "desc": "街上挂灯笼，有一盏挂歪了被扶正；天色渐暗，灯笼依次点亮"
  },
  {
   "key": "v1c",
   "start": 54.47,
   "end": 74.35,
   "desc": "夕阳下跑过拱桥 → 阴天屋顶摆桌、抛月饼"
  },
  {
   "key": "pre1",
   "start": 74.35,
   "end": 87.17,
   "desc": "云太厚：搬来望远镜，望远镜视角，云后透出光"
  },
  {
   "key": "ch1",
   "start": 87.17,
   "end": 109.92,
   "desc": "云散开、跳起来；月饼对月亮「咬一口」的小笑话"
  },
  {
   "key": "int1",
   "start": 109.92,
   "end": 128.4,
   "desc": "对着巨大月亮吹笛 → 屋顶喝茶"
  },
  {
   "key": "v2",
   "start": 128.4,
   "end": 149.59,
   "desc": "猜灯谜「越借越圆的是什么？」、兔子灯 → 屋檐下避雨，荷叶伞"
  },
  {
   "key": "pre2",
   "start": 149.59,
   "end": 166.27,
   "desc": "手机视频里的玄砚 → 小镇各处亮起屏幕光"
  },
  {
   "key": "ch2",
   "start": 166.27,
   "end": 190.46,
   "desc": "屋顶音乐会 + 烟花；鼓、琵琶古筝特写"
  },
  {
   "key": "bridge",
   "start": 190.46,
   "end": 201.85,
   "desc": "独自坐在河边台阶，给水里的月亮倒一杯茶"
  },
  {
   "key": "solo",
   "start": 201.85,
   "end": 209.85,
   "desc": "大家睡成一堆，只剩一个还在弹吉他"
  },
  {
   "key": "fin",
   "start": 209.85,
   "end": 229.18,
   "desc": "视频通话 → 挤在一起自拍（闪光）→ 两两走回家"
  },
  {
   "key": "int2",
   "start": 229.18,
   "end": 238.98,
   "desc": "屋顶放孔明灯，镜头跟着升上月亮"
  },
  {
   "key": "fin2",
   "start": 238.98,
   "end": 249.2,
   "desc": "小镇一盏盏熄灯 → 最后一扇窗挥手、关灯"
  },
  {
   "key": "credits",
   "start": 249.2,
   "end": 255.0,
   "desc": "片尾：21 位小机依次画出"
  }
